rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isActiveUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
    }

    function isAdmin() {
      return isActiveUser() && roleOf(request.auth.uid) == 'admin';
    }

    function canModerate() {
      return isActiveUser() && roleOf(request.auth.uid) in ['admin', 'moderator'];
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.isBanned == false
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'bio', 'role', 'isBanned', 'createdAt'
        ]);
      allow update: if (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'bio'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 500
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL'])
            || request.resource.data.photoURL == null
            || request.resource.data.photoURL is string
          )
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'isBanned'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            || request.resource.data.role in ['admin', 'moderator', 'user']
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBanned'])
            || request.resource.data.isBanned is bool
          )
        );
      allow delete: if (isAdmin() && uid != request.auth.uid)
        || (signedIn() && request.auth.uid == uid);

        match /followers/{followerUid} {
          allow read: if true;
          allow create: if isActiveUser()
            && request.auth.uid == followerUid
            && uid != followerUid
            && exists(/databases/$(database)/documents/users/$(uid))
            && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
            && request.resource.data.followerId == followerUid
            && request.resource.data.followingId == uid
            && request.resource.data.createdAt is number;
          allow delete: if (isActiveUser() && request.auth.uid == followerUid)
            || (signedIn() && request.auth.uid == uid);
          allow update: if false;
        }

        match /following/{followingUid} {
          allow read: if signedIn() && request.auth.uid == uid;
          allow create: if isActiveUser()
            && request.auth.uid == uid
            && followingUid != uid
            && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
            && request.resource.data.followerId == uid
            && request.resource.data.followingId == followingUid
            && request.resource.data.createdAt is number;
          allow delete: if signedIn() && request.auth.uid == uid;
          allow update: if false;
        }

        match /notifications/{notificationId} {
          allow read: if signedIn() && request.auth.uid == uid;
          allow create: if isActiveUser()
            && request.resource.data.keys().hasOnly([
              'recipientId', 'actorId', 'actorName', 'actorPhotoURL', 'kind', 'targetId', 'createdAt', 'read'
            ])
            && request.resource.data.recipientId == uid
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.actorId != uid
            && request.resource.data.actorName
              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
            && request.resource.data.actorPhotoURL
              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoURL
            && request.resource.data.kind in ['follow', 'like', 'comment']
            && request.resource.data.createdAt is number
            && request.resource.data.read == false
            && (
              (request.resource.data.kind == 'follow'
                && existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)))
              || (request.resource.data.kind in ['like', 'comment']
                && request.resource.data.targetId is string
                && get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.author.uid == uid)
            );
          allow update: if signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            && request.resource.data.read == true;
          allow delete: if signedIn() && request.auth.uid == uid;
        }

        match /likedPosts/{postId} {
          allow read: if signedIn() && request.auth.uid == uid;
          allow create: if isActiveUser()
            && request.auth.uid == uid
            && postId != request.auth.uid
            && request.resource.data.keys().hasOnly(['postId', 'createdAt'])
            && request.resource.data.postId == postId
            && request.resource.data.createdAt is number
            && exists(/databases/$(database)/documents/posts/$(postId));
          allow delete: if isActiveUser() && request.auth.uid == uid;
          allow update: if false;
        }
    }

    match /userPrivate/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt']);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /posts/{postId} {
      allow read: if resource.data.get('isPrivate', false) != true
        || (signedIn() && resource.data.author.uid == request.auth.uid)
        || canModerate();
      allow create: if isActiveUser()
        && request.resource.data.author.uid == request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.author.displayName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.modelPath
          == 'models/' + request.auth.uid + '/' + postId + '.glb'
        && request.resource.data.thumbnailPath
          == 'thumbnails/' + request.auth.uid + '/' + postId + '.png'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.isPrivate is bool
        && request.resource.data.likes == 0
        && request.resource.data.likesCount == 0
        && request.resource.data.viewsCount == 0
        && request.resource.data.remixCount == 0;
      allow update: if isActiveUser() && (
        (
          resource.data.author.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'description', 'tags', 'isPrivate'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.isPrivate is bool
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount'])
          && request.resource.data.likes is int
          && request.resource.data.likesCount is int
          && request.resource.data.likes == request.resource.data.likesCount
          && request.resource.data.likes >= 0
          && (
            (
              request.resource.data.likes == resource.data.likes + 1
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            ) || (
              request.resource.data.likes == resource.data.likes - 1
              && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            )
          )
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
          && request.resource.data.viewsCount == resource.data.viewsCount + 1
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remixCount'])
          && request.resource.data.remixCount == resource.data.remixCount + 1
        ) || (
          canModerate()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPrivate'])
          && request.resource.data.isPrivate is bool
        )
      );
      allow delete: if (signedIn() && resource.data.author.uid == request.auth.uid) || canModerate();

      match /likes/{likerUid} {
        allow read: if true;
        allow create: if isActiveUser()
          && request.auth.uid == likerUid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == likerUid
          && request.resource.data.createdAt is number;
        allow delete: if isActiveUser() && request.auth.uid == likerUid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/posts/$(postId)).data.get('isPrivate', false) != true
          || (signedIn() && get(/databases/$(database)/documents/posts/$(postId)).data.author.uid == request.auth.uid)
          || canModerate();
        allow create: if isActiveUser()
          && get(/databases/$(database)/documents/posts/$(postId)).data.get('isPrivate', false) != true
          && request.resource.data.author.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if signedIn()
          && resource.data.author.uid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.author.uid == request.auth.uid)
          || canModerate()
          || (signedIn()
            && get(/databases/$(database)/documents/posts/$(postId)).data.author.uid == request.auth.uid);
      }
    }

    match /reports/{reportId} {
      allow read: if canModerate();
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'postId', 'postTitle', 'reporterId', 'reporterName', 'reason', 'details', 'status', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.postId is string
        && request.resource.data.postTitle is string
        && request.resource.data.reason in ['spam', 'inappropriate', 'copyright', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is number
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['resolved', 'dismissed']
        && request.resource.data.resolvedAt is number;
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if canModerate();
      allow create: if request.resource.data.keys().hasOnly([
          'userId', 'name', 'email', 'type', 'subject', 'message', 'status', 'createdAt'
        ])
        && (signedIn()
          ? request.resource.data.userId == request.auth.uid
          : request.resource.data.userId == '')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.type in ['bug', 'idea', 'account', 'collaboration', 'other']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is number;
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'reviewing', 'resolved']
        && request.resource.data.updatedAt is number;
      allow delete: if canModerate();
    }

    match /communityQuestions/{questionId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorPhotoURL', 'title', 'body', 'tags',
          'createdAt', 'answersCount', 'votes', 'voterIds', 'resolved', 'pinned',
          'locked', 'acceptedAnswerId'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && (request.resource.data.authorPhotoURL == null
          || request.resource.data.authorPhotoURL
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoURL)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 8
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 15
        && request.resource.data.body.size() <= 4000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        && request.resource.data.createdAt is number
        && request.resource.data.answersCount == 0
        && request.resource.data.votes == 0
        && request.resource.data.voterIds == []
        && request.resource.data.resolved == false
        && request.resource.data.pinned == false
        && request.resource.data.locked == false
        && request.resource.data.acceptedAnswerId == null;
      allow update: if (
          isActiveUser()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'body', 'tags', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 8
          && request.resource.data.title.size() <= 140
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 15
          && request.resource.data.body.size() <= 4000
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 5
        ) || (
          isActiveUser()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['resolved', 'updatedAt'])
          && request.resource.data.resolved is bool
        ) || (
          isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['votes', 'voterIds'])
          && request.resource.data.votes is int
          && request.resource.data.votes >= 0
          && request.resource.data.voterIds is list
          && (
            (request.resource.data.votes == resource.data.votes + 1
              && request.resource.data.voterIds.hasAll(resource.data.voterIds)
              && request.resource.data.voterIds.size() == resource.data.voterIds.size() + 1
              && request.resource.data.voterIds.hasAny([request.auth.uid])
              && !resource.data.voterIds.hasAny([request.auth.uid]))
            || (request.resource.data.votes == resource.data.votes - 1
              && resource.data.voterIds.hasAny([request.auth.uid])
              && !request.resource.data.voterIds.hasAny([request.auth.uid])
              && request.resource.data.voterIds.size() == resource.data.voterIds.size() - 1)
          )
        ) || (
          isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answersCount'])
          && request.resource.data.answersCount == resource.data.answersCount + 1
        ) || (
          isActiveUser()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acceptedAnswerId', 'resolved', 'updatedAt'])
          && request.resource.data.resolved == true
          && request.resource.data.acceptedAnswerId is string
          && exists(/databases/$(database)/documents/communityQuestions/$(questionId)/answers/$(request.resource.data.acceptedAnswerId))
        ) || (
          canModerate()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pinned', 'locked', 'resolved', 'updatedAt'])
        );
      allow delete: if (isActiveUser() && resource.data.authorId == request.auth.uid)
        || canModerate();

      match /answers/{answerId} {
        allow read: if true;
        allow create: if isActiveUser()
          && get(/databases/$(database)/documents/communityQuestions/$(questionId)).data.locked == false
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'authorPhotoURL', 'body', 'createdAt', 'votes', 'voterIds', 'accepted'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && (request.resource.data.authorPhotoURL == null
            || request.resource.data.authorPhotoURL
              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoURL)
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.createdAt is number
          && request.resource.data.votes == 0
          && request.resource.data.voterIds == []
          && request.resource.data.accepted == false;
        allow update: if (
            isActiveUser()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body'])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 4000
          ) || (
            isActiveUser()
            && get(/databases/$(database)/documents/communityQuestions/$(questionId)).data.authorId
              == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted'])
            && request.resource.data.accepted is bool
          );
        allow delete: if (isActiveUser() && resource.data.authorId == request.auth.uid)
          || canModerate()
          || (isActiveUser()
            && get(/databases/$(database)/documents/communityQuestions/$(questionId)).data.authorId
              == request.auth.uid);
      }
    }

    match /chats/{chatId} {
      function isParticipant(participants) {
        return signedIn()
          && participants is list
          && participants.size() == 2
          && participants.hasAny([request.auth.uid]);
      }
      function validConversation(participants) {
        return participants is list
          && participants.size() == 2
          && participants[0] is string
          && participants[1] is string
          && participants[0] < participants[1]
          && chatId == participants[0] + '__' + participants[1];
      }
      allow get: if signedIn()
        && chatId.split('__').hasAny([request.auth.uid])
        && (!exists(/databases/$(database)/documents/chats/$(chatId))
          || isParticipant(resource.data.participantIds));
      allow list: if isParticipant(resource.data.participantIds);
      allow create: if isActiveUser()
        && validConversation(request.resource.data.participantIds)
        && isParticipant(request.resource.data.participantIds)
        && request.resource.data.keys().hasOnly(['participantIds', 'updatedAt', 'lastMessage'])
        && request.resource.data.updatedAt is number
        && (!('lastMessage' in request.resource.data)
          || (request.resource.data.participantIds.hasAny([request.resource.data.lastMessage.senderId])
            && request.resource.data.lastMessage.text is string
            && request.resource.data.lastMessage.text.size() > 0
            && request.resource.data.lastMessage.text.size() <= 2000));
      allow update: if (
          isActiveUser()
          && isParticipant(resource.data.participantIds)
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage'])
          && request.resource.data.updatedAt is number
          && (request.resource.data.lastMessage.senderId == request.auth.uid
            || (!('lastMessage' in resource.data)
              && resource.data.participantIds.hasAny([request.resource.data.lastMessage.senderId])))
          && request.resource.data.lastMessage.text is string
          && request.resource.data.lastMessage.text.size() > 0
          && request.resource.data.lastMessage.text.size() <= 2000
        ) || (
          isParticipant(resource.data.participantIds)
          && request.resource.data.participantIds is list
          && request.resource.data.participantIds.size() == 2
          && request.resource.data.participantIds.hasAny(['deleted-account'])
          && request.resource.data.participantIds.hasAny(resource.data.participantIds)
          && !request.resource.data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantIds', 'lastMessage'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
            || (
              resource.data.lastMessage.senderId == request.auth.uid
              && request.resource.data.lastMessage.senderId == 'deleted-account'
              && request.resource.data.lastMessage.senderName == 'Cuenta eliminada'
              && request.resource.data.lastMessage.text == resource.data.lastMessage.text
              && request.resource.data.lastMessage.diff(resource.data.lastMessage)
                .affectedKeys().hasOnly(['senderId', 'senderName'])
            )
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return signedIn() && chatId.split('__').hasAny([request.auth.uid]);
        }
        allow read: if isParticipant();
        allow create: if isParticipant()
        && isActiveUser()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
        allow update: if isParticipant()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['senderId', 'senderName'])
          && request.resource.data.senderId == 'deleted-account'
          && request.resource.data.senderName == 'Cuenta eliminada';
        allow delete: if false;
      }
    }

    /* ========================================================================
       COLABORACIÓN — Proyectos, miembros, invitaciones y actividad
       ======================================================================== */

    function isProjectMember(projectId, uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/projectMembers/$(projectId + '_' + uid));
    }

    function projectMemberData(projectId, uid) {
      return get(/databases/$(database)/documents/projectMembers/$(projectId + '_' + uid)).data;
    }

    function isProjectWriter(projectId) {
      return signedIn()
        && isProjectMember(projectId, request.auth.uid)
        && projectMemberData(projectId, request.auth.uid).role in ['owner', 'editor'];
    }

    function isProjectOwner(projectId) {
      return signedIn()
        && isProjectMember(projectId, request.auth.uid)
        && projectMemberData(projectId, request.auth.uid).role == 'owner';
    }

    match /projects/{projectId} {
      allow read: if signedIn()
        && (isAdmin()
          || resource.data.isPublic == true
          || isProjectMember(projectId, request.auth.uid)
          || resource.data.ownerId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;

      allow update: if signedIn()
        && (isAdmin() || isProjectOwner(projectId) || isProjectWriter(projectId))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'description', 'isPublic', 'updatedAt', 'thumbnailUrl', 'sceneJson']);

      allow delete: if signedIn() && (isAdmin() || isProjectOwner(projectId));
    }

    match /projectMembers/{memberId} {
      allow read: if signedIn()
        && (isAdmin()
          || (resource.data.projectId is string && isProjectMember(resource.data.projectId, request.auth.uid))
          || (resource.data.projectId is string
            && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid));

      allow create: if signedIn()
        && request.resource.data.projectId is string
        && request.resource.data.userId is string
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 120
        && request.resource.data.role in ['owner', 'editor', 'viewer']
        && request.resource.data.joinedAt is number
        && memberId == request.resource.data.projectId + '_' + request.resource.data.userId
        && request.resource.data.keys().hasOnly([
          'id', 'projectId', 'userId', 'userName', 'userPhotoURL', 'role', 'joinedAt'
        ])
        && request.resource.data.id == memberId
        && (request.resource.data.userPhotoURL == null || request.resource.data.userPhotoURL is string)
        && (
          isAdmin()
          || (request.resource.data.userId == request.auth.uid
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid)
          || (isProjectWriter(request.resource.data.projectId) && request.resource.data.role in ['editor', 'viewer'])
          || (request.resource.data.userId == request.auth.uid
            && request.resource.data.role in ['viewer', 'editor']
            && request.auth.token.email is string
            && existsAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + request.auth.token.email))
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + request.auth.token.email)).data.projectId == request.resource.data.projectId
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + request.auth.token.email)).data.invitedEmail == request.auth.token.email
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + request.auth.token.email)).data.invitedUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + request.auth.token.email)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + request.auth.token.email)).data.role == request.resource.data.role
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + request.auth.token.email)).data.respondedAt is number
            && request.resource.data.joinedAt >= request.time.toMillis() - 300000
            && request.resource.data.joinedAt <= request.time.toMillis() + 300000)
        );

      allow update: if signedIn()
        && memberId == resource.data.projectId + '_' + resource.data.userId
        && (
          (
            isAdmin() || isProjectOwner(resource.data.projectId)
          ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['owner', 'editor', 'viewer']
          || (
            request.auth.uid == resource.data.userId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['userName', 'userPhotoURL'])
            && request.resource.data.userName is string
            && request.resource.data.userName.size() > 0
            && request.resource.data.userName.size() <= 120
            && (request.resource.data.userPhotoURL == null || request.resource.data.userPhotoURL is string)
          )
        );

      allow delete: if signedIn()
        && (isAdmin() || isProjectOwner(resource.data.projectId) || request.auth.uid == resource.data.userId);
    }

    match /projectInvitations/{invitationId} {
      allow read: if signedIn()
        && (resource.data.invitedBy == request.auth.uid
          || (request.auth.token.email is string && resource.data.invitedEmail == request.auth.token.email)
          || isProjectWriter(resource.data.projectId));

      allow create: if signedIn()
        && isProjectWriter(request.resource.data.projectId)
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.invitedEmail is string
        && request.resource.data.invitedEmail.size() > 0
        && request.resource.data.invitedEmail.size() <= 120
        && request.resource.data.projectId is string
        && invitationId == request.resource.data.projectId + '_' + request.resource.data.invitedEmail
        && request.resource.data.role in ['owner', 'editor', 'viewer']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.projectName is string
        && request.resource.data.keys().hasOnly([
          'id', 'projectId', 'projectName', 'invitedBy', 'invitedByName', 'invitedEmail',
          'invitedUid', 'role', 'status', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.id == invitationId
        && request.resource.data.invitedUid == null;

      allow update: if signedIn()
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.invitedEmail == resource.data.invitedEmail
        && (
          (
            // Reenvío/actualización de invitación pendiente por un miembro con permisos de escritura.
            isProjectWriter(resource.data.projectId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'projectName', 'invitedBy', 'invitedByName', 'role', 'status', 'createdAt', 'expiresAt', 'invitedUid'
            ])
            && request.resource.data.status == 'pending'
            && request.resource.data.role in ['owner', 'editor', 'viewer']
            && request.resource.data.createdAt is number
            && request.resource.data.expiresAt is number
            && request.resource.data.invitedUid == null
            && request.resource.data.projectName is string
          ) || (
            // Aceptación/rechazo por la persona invitada, o revocación/expiración por quien invitó.
            (resource.data.invitedBy == request.auth.uid
              || (request.auth.token.email is string && resource.data.invitedEmail == request.auth.token.email))
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'respondedAt', 'invitedUid'])
            && request.resource.data.status in ['pending', 'accepted', 'rejected', 'revoked', 'expired']
            && (
              request.resource.data.status == resource.data.status
              || (
                resource.data.status == 'pending'
                && request.resource.data.respondedAt is number
                && (
                  (
                    request.auth.token.email is string
                    && resource.data.invitedEmail == request.auth.token.email
                    && request.resource.data.status in ['accepted', 'rejected']
                    && request.resource.data.invitedUid == request.auth.uid
                  ) || (
                    resource.data.invitedBy == request.auth.uid
                    && request.resource.data.status in ['revoked', 'expired', 'pending']
                  )
                )
              )
            )
          )
        );

      allow delete: if signedIn()
        && (resource.data.invitedBy == request.auth.uid || isProjectOwner(resource.data.projectId));
    }

    match /projectActivity/{activityId} {
      allow read: if signedIn()
        && isProjectMember(resource.data.projectId, request.auth.uid);

      allow create: if signedIn()
        && isProjectWriter(resource.data.projectId)
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action in [
          'object_created', 'object_updated', 'object_deleted',
          'material_changed', 'layer_changed'
        ]
        && request.resource.data.objectId is string
        && request.resource.data.objectType is string
        && request.resource.data.createdAt is number;

      allow update: if false;
      allow delete: if false;
    }

    match /projectPresences/{presenceId} {
      allow read: if signedIn()
        && isProjectMember(resource.data.projectId, request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.projectId is string
        && request.resource.data.displayName is string
        && request.resource.data.isOnline is bool
        && request.resource.data.lastSeen is number;

      allow update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isOnline', 'currentObjectId', 'cursorX', 'cursorY', 'lastSeen']);

      allow delete: if signedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    match /helpArticles/{articleId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id', 'category', 'title', 'subtitle', 'icon', 'keywords',
          'body', 'steps', 'tip', 'order', 'isPublished', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.category in [
          'primeros-pasos', 'editor', 'publicacion', 'comunidad', 'colaboracion', 'cuenta'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.subtitle is string
        && request.resource.data.subtitle.size() > 0
        && request.resource.data.subtitle.size() <= 200
        && request.resource.data.icon is string
        && request.resource.data.keywords is string
        && request.resource.data.body is list
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['category', 'title', 'subtitle', 'icon', 'keywords', 'body', 'steps', 'tip', 'order', 'isPublished', 'updatedAt']);
      allow delete: if isAdmin();
    }
  }
}
