rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'user')
        : 'user';
    }

    function isActiveUser() {
      return signedIn()
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true
        );
    }

    function isAdmin() {
      return isActiveUser() && roleOf(request.auth.uid) == 'admin';
    }

    function canModerate() {
      return isActiveUser() && roleOf(request.auth.uid) in ['admin', 'moderator'];
    }

    // El cliente guarda los correos en minúsculas, así que el token también se
    // normaliza con `lower()`. Sin esto, una cuenta con mayúsculas en el correo
    // no puede ver ni aceptar sus invitaciones y la consulta se rechaza con
    // "Missing or insufficient permissions".
    function tokenEmailLower() {
      return request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function pendingInvitationForRequester(projectId) {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/projectInvitations/$(projectId + '_' + tokenEmailLower()))
        && get(/databases/$(database)/documents/projectInvitations/$(projectId + '_' + tokenEmailLower())).data.status == 'pending';
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.isBanned == false
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'bio', 'role', 'isBanned', 'createdAt'
        ])
      ) || (
        // Un usuario puede guardar su perfil antes de que exista el documento
        // completo (p. ej. justo después de autenticarse por primera vez).
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'bio'])
      );
      allow update: if (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'bio'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 500
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL'])
            || request.resource.data.photoURL == null
            || request.resource.data.photoURL is string
          )
        ) || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.isBanned == resource.data.isBanned
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'bio'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 500
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL'])
            || request.resource.data.photoURL == null
            || request.resource.data.photoURL is string
          )
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'isBanned'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            || request.resource.data.role in ['admin', 'moderator', 'user']
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBanned'])
            || request.resource.data.isBanned is bool
          )
        );
      allow delete: if (isAdmin() && uid != request.auth.uid)
        || (signedIn() && request.auth.uid == uid);

        match /followers/{followerUid} {
          allow read: if true;
          allow list: if true;
          allow create: if isActiveUser()
            && request.auth.uid == followerUid
            && uid != followerUid
            && exists(/databases/$(database)/documents/users/$(uid))
            && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
            && request.resource.data.followerId == followerUid
            && request.resource.data.followingId == uid
            && request.resource.data.createdAt is number;
          allow delete: if (isActiveUser() && request.auth.uid == followerUid)
            || (signedIn() && request.auth.uid == uid);
          allow update: if false;
        }

        match /following/{followingUid} {
          // Igual que `followers`: la lista de a quién sigue un usuario es pública.
          // Si fuera privada, la consulta que cuenta seguidores/seguidores de otro
          // perfil no se podría demostrar y Firestore la rechazaría con
          // "Missing or insufficient permissions".
          allow read: if true;
          allow list: if true;
          allow create: if isActiveUser()
            && request.auth.uid == uid
            && followingUid != uid
            && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
            && request.resource.data.followerId == uid
            && request.resource.data.followingId == followingUid
            && request.resource.data.createdAt is number;
          allow delete: if signedIn() && request.auth.uid == uid;
          allow update: if false;
        }

        // Sin comodín `{notificationId}` el motor real ignora este `match` por
        // completo: un `match /notifications { ... }` sin documento no enlaza
        // ninguna regla a las lecturas (el simulador `:test` sí lo interpreta,
        // por eso las pruebas pasaban y producción devolvía 403). El `list`
        // vive dentro del match del documento.
        match /notifications/{notificationId} {
          allow read: if signedIn() && request.auth.uid == uid;
          allow list: if signedIn() && request.auth.uid == uid;
          allow create: if isActiveUser()
            && request.resource.data.keys().hasOnly([
              'id', 'recipientId', 'actorId', 'actorName', 'actorPhotoURL', 'kind', 'targetId', 'createdAt', 'read'
            ])
            && request.resource.data.recipientId == uid
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.actorId != uid
            && request.resource.data.actorName is string
            && request.resource.data.actorName.size() <= 120
            && (request.resource.data.actorPhotoURL == null || request.resource.data.actorPhotoURL is string)
            && request.resource.data.kind in ['follow', 'like', 'comment', 'message', 'remix', 'share', 'invite']
            && request.resource.data.createdAt is number
            && request.resource.data.read == false
            && (
              request.resource.data.kind == 'follow'
              || (request.resource.data.kind == 'like' && request.resource.data.targetId is string)
              || (request.resource.data.kind == 'comment' && request.resource.data.targetId is string)
              || (request.resource.data.kind == 'message' && request.resource.data.targetId is string)
              || (request.resource.data.kind == 'remix' && request.resource.data.targetId is string)
              || (request.resource.data.kind == 'share' && request.resource.data.targetId is string)
              || (request.resource.data.kind == 'invite' && request.resource.data.targetId is string)
            );
          allow update: if signedIn()
            && (
              (
                request.auth.uid == uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                && request.resource.data.read == true
              ) || (
                // El autor de la notificación puede actualizarla (p. ej. al
                // repetir un like). Solo se permite reescribir los campos que
                // la `create` habría escrito, sin cambiar kind/id/targetId
                // ajenos: afectan a la relación actor→buzón.
                isActiveUser()
                && resource.data.actorId == request.auth.uid
                && resource.data.recipientId == uid
                && request.resource.data.actorId == request.auth.uid
                && request.resource.data.recipientId == uid
                && request.resource.data.kind == resource.data.kind
                && request.resource.data.kind in ['follow', 'like', 'comment', 'message', 'remix', 'share', 'invite']
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['actorName', 'actorPhotoURL', 'targetId', 'createdAt', 'read'])
                && request.resource.data.actorName is string
                && request.resource.data.actorName.size() <= 120
                && (request.resource.data.actorPhotoURL == null || request.resource.data.actorPhotoURL is string)
                && request.resource.data.createdAt is number
                && request.resource.data.read is bool
              )
            );
          allow delete: if signedIn() && request.auth.uid == uid;
        }

        match /likedPosts/{postId} {
          allow read: if signedIn() && request.auth.uid == uid;
          allow list: if signedIn() && request.auth.uid == uid;
          allow create: if isActiveUser()
            && request.auth.uid == uid
            && postId != request.auth.uid
            && request.resource.data.keys().hasOnly(['postId', 'createdAt'])
            && request.resource.data.postId == postId
            && request.resource.data.createdAt is number
            && exists(/databases/$(database)/documents/posts/$(postId));
          allow delete: if isActiveUser() && request.auth.uid == uid;
          allow update: if false;
        }

        match /recentChats/{chatId} {
          // Índice por usuario de conversaciones: es lo que el chat muestra
          // como "Recientes". Cada quien lee/gestiona únicamente el suyo;
          // quien escribe debe ser participante del chat y la fila debe
          // coincidir con el documento `chats/{chatId}` real.
          allow read: if signedIn() && request.auth.uid == uid;
          allow create, update: if signedIn()
            && isActiveUser()
            && request.resource.data.writtenBy == request.auth.uid
            && request.resource.data.participantIds is list
            && request.resource.data.participantIds.size() == 2
            && request.resource.data.participantIds.hasAny([uid])
            && request.resource.data.participantIds.hasAll([uid, request.auth.uid])
            && request.resource.data.participantIds[0] is string
            && request.resource.data.participantIds[1] is string
            && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
            && chatId == request.resource.data.participantIds[0] + '__' + request.resource.data.participantIds[1]
            && get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
                 == request.resource.data.participantIds
            && request.resource.data.updatedAt is number
            && (!('lastMessage' in request.resource.data)
              || (request.resource.data.lastMessage.senderId in request.resource.data.participantIds
                && request.resource.data.lastMessage.text is string
                && request.resource.data.lastMessage.text.size() > 0
                && request.resource.data.lastMessage.text.size() <= 2000));
          allow delete: if signedIn() && request.auth.uid == uid;
        }
    }

    match /userPrivate/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt']);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /posts/{postId} {
      // Se compara con `authorId` (campo plano) y no con
      // `resource.data.author.uid` porque el cliente consulta con
      // `where('authorId','==',uid)`. Firestore solo acepta una consulta si
      // puede DEMOSTRAR que la regla se cumple para todos los documentos que
      // podrían salir; con `author.uid` no se puede demostrar y la consulta
      // entera falla con "Missing or insufficient permissions".
      // `authorId` es obligatorio al crear el post (regla de `create` de más
      // abajo), así que ambos campos son equivalentes.
      allow read: if resource.data.get('isPrivate', false) != true
        || (signedIn() && resource.data.get('authorId', '') == request.auth.uid)
        || canModerate();
      allow create: if isActiveUser()
        && request.resource.data.author.uid == request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || request.resource.data.author.displayName
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        )
        && request.resource.data.modelPath
          == 'models/' + request.auth.uid + '/' + postId + '.glb'
        && request.resource.data.thumbnailPath
          == 'thumbnails/' + request.auth.uid + '/' + postId + '.png'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.isPrivate is bool
        && request.resource.data.likes == 0
        && request.resource.data.likesCount == 0
        && request.resource.data.viewsCount == 0
        && request.resource.data.remixCount == 0;
      allow update: if isActiveUser() && (
        (
          resource.data.author.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'description', 'tags', 'isPrivate'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.isPrivate is bool
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount'])
          && request.resource.data.likes is int
          && request.resource.data.likesCount is int
          && request.resource.data.likes == request.resource.data.likesCount
          && request.resource.data.likes >= 0
          && (
            (
              request.resource.data.likes == resource.data.likes + 1
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            ) || (
              request.resource.data.likes == resource.data.likes - 1
              && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            )
          )
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
          && request.resource.data.viewsCount == resource.data.viewsCount + 1
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remixCount'])
          && request.resource.data.remixCount == resource.data.remixCount + 1
        ) || (
          canModerate()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPrivate'])
          && request.resource.data.isPrivate is bool
        )
      );
      allow delete: if (signedIn() && resource.data.author.uid == request.auth.uid) || canModerate();

      match /likes/{likerUid} {
        allow read: if true;
        allow create: if isActiveUser()
          && request.auth.uid == likerUid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == likerUid
          && request.resource.data.createdAt is number;
        allow delete: if isActiveUser() && request.auth.uid == likerUid
          || (signedIn()
            && get(/databases/$(database)/documents/posts/$(postId)).data.author.uid == request.auth.uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/posts/$(postId)).data.get('isPrivate', false) != true
          || (signedIn() && get(/databases/$(database)/documents/posts/$(postId)).data.author.uid == request.auth.uid)
          || canModerate();
        allow create: if isActiveUser()
          && get(/databases/$(database)/documents/posts/$(postId)).data.get('isPrivate', false) != true
          && request.resource.data.author.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.id is string         && request.resource.data.createdAt is number         && request.resource.data.author is map;
        allow update: if signedIn()
          && resource.data.author.uid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.author.uid == request.auth.uid)
          || canModerate()
          || (signedIn()
            && get(/databases/$(database)/documents/posts/$(postId)).data.author.uid == request.auth.uid);
      }
    }

    match /reports/{reportId} {
      allow read: if canModerate();
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'postId', 'postTitle', 'reporterId', 'reporterName', 'reason', 'details', 'status', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || request.resource.data.reporterName
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        )
        && request.resource.data.postId is string
        && request.resource.data.postTitle is string
        && request.resource.data.reason in ['spam', 'inappropriate', 'copyright', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is number
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['resolved', 'dismissed']
        && request.resource.data.resolvedAt is number;
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if canModerate();
      allow create: if request.resource.data.keys().hasOnly([
          'userId', 'name', 'email', 'type', 'subject', 'message', 'status', 'createdAt'
        ])
        && (signedIn()
          ? request.resource.data.userId == request.auth.uid
          : request.resource.data.userId == '')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.type in ['bug', 'idea', 'account', 'collaboration', 'other']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is number;
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'reviewing', 'resolved']
        && request.resource.data.updatedAt is number;
      allow delete: if canModerate();
    }

    match /communityQuestions/{questionId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorPhotoURL', 'title', 'body', 'tags',
          'createdAt', 'answersCount', 'votes', 'voterIds', 'resolved', 'pinned',
          'locked', 'acceptedAnswerId'
        ])
        && request.resource.data.authorId == request.auth.uid
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || request.resource.data.authorName
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        )
        && (request.resource.data.authorPhotoURL == null
          || !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || request.resource.data.authorPhotoURL
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoURL)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 8
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 15
        && request.resource.data.body.size() <= 4000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        && request.resource.data.createdAt is number
        && request.resource.data.answersCount == 0
        && request.resource.data.votes == 0
        && request.resource.data.voterIds == []
        && request.resource.data.resolved == false
        && request.resource.data.pinned == false
        && request.resource.data.locked == false
        && request.resource.data.acceptedAnswerId == null;
      allow update: if (
          isActiveUser()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'body', 'tags', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 8
          && request.resource.data.title.size() <= 140
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 15
          && request.resource.data.body.size() <= 4000
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 5
        ) || (
          isActiveUser()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['resolved', 'updatedAt'])
          && request.resource.data.resolved is bool
        ) || (
          isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['votes', 'voterIds'])
          && request.resource.data.votes is int
          && request.resource.data.votes >= 0
          && request.resource.data.voterIds is list
          && (
            (request.resource.data.votes == resource.data.votes + 1
              && request.resource.data.voterIds.hasAll(resource.data.voterIds)
              && request.resource.data.voterIds.size() == resource.data.voterIds.size() + 1
              && request.resource.data.voterIds.hasAny([request.auth.uid])
              && !resource.data.voterIds.hasAny([request.auth.uid]))
            || (request.resource.data.votes == resource.data.votes - 1
              && resource.data.voterIds.hasAny([request.auth.uid])
              && !request.resource.data.voterIds.hasAny([request.auth.uid])
              && request.resource.data.voterIds.size() == resource.data.voterIds.size() - 1)
          )
        ) || (
          isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answersCount'])
          && request.resource.data.answersCount == resource.data.answersCount + 1
        ) || (
          isActiveUser()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acceptedAnswerId', 'resolved', 'updatedAt'])
          && request.resource.data.resolved == true
          && request.resource.data.acceptedAnswerId is string
          && exists(/databases/$(database)/documents/communityQuestions/$(questionId)/answers/$(request.resource.data.acceptedAnswerId))
        ) || (
          canModerate()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pinned', 'locked', 'resolved', 'updatedAt'])
        );
      allow delete: if (isActiveUser() && resource.data.authorId == request.auth.uid)
        || canModerate();

      match /answers/{answerId} {
        allow read: if true;
        allow create: if isActiveUser()
          && get(/databases/$(database)/documents/communityQuestions/$(questionId)).data.locked == false
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'authorPhotoURL', 'body', 'createdAt', 'votes', 'voterIds', 'accepted'
          ])
          && request.resource.data.authorId == request.auth.uid
          && (
            !exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || request.resource.data.authorName
              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          )
          && (request.resource.data.authorPhotoURL == null
            || !exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || request.resource.data.authorPhotoURL
              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoURL)
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.createdAt is number
          && request.resource.data.votes == 0
          && request.resource.data.voterIds == []
          && request.resource.data.accepted == false;
        allow update: if (
            isActiveUser()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body'])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 4000
          ) || (
            isActiveUser()
            && get(/databases/$(database)/documents/communityQuestions/$(questionId)).data.authorId
              == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted'])
            && request.resource.data.accepted is bool
          );
        allow delete: if (isActiveUser() && resource.data.authorId == request.auth.uid)
          || canModerate()
          || (isActiveUser()
            && get(/databases/$(database)/documents/communityQuestions/$(questionId)).data.authorId
              == request.auth.uid);
      }
    }

    match /chats/{chatId} {
      // La administración de los documentos de la colección vive aquí. El
      // listado por usuario vive en `users/{uid}/recentChats`; una consulta a
      // `/chats` solo está permitida a administradores (limpieza de cuentas
      // eliminadas). El `list` vive aquí; un `match /chats { ... }` sin
      // comodín no enlazaría regla alguna en el motor real.
      function isParticipant(participants) {
        return signedIn()
          && participants is list
          && participants.size() == 2
          && participants.hasAny([request.auth.uid]);
      }
      function validConversation(participants) {
        return participants is list
          && participants.size() == 2
          && participants[0] is string
          && participants[1] is string
          && participants[0] < participants[1]
          && chatId == participants[0] + '__' + participants[1];
      }
      allow list: if isAdmin();
      allow get: if signedIn()
        && chatId.split('__').hasAny([request.auth.uid])
        && (!exists(/databases/$(database)/documents/chats/$(chatId))
          || isParticipant(resource.data.participantIds));
      allow create: if isActiveUser()
        && validConversation(request.resource.data.participantIds)
        && isParticipant(request.resource.data.participantIds)
        && request.resource.data.keys().hasOnly(['participantIds', 'updatedAt', 'lastMessage'])
        && request.resource.data.updatedAt is number
        && (!('lastMessage' in request.resource.data)
          || (request.resource.data.participantIds.hasAny([request.resource.data.lastMessage.senderId])
            && request.resource.data.lastMessage.text is string
            && request.resource.data.lastMessage.text.size() > 0
            && request.resource.data.lastMessage.text.size() <= 2000));
      allow update: if (
          isActiveUser()
          && isParticipant(resource.data.participantIds)
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage'])
          && request.resource.data.updatedAt is number
          // El `lastMessage` puede ser de cualquiera de los dos participantes
          // (igual que en `create`): si no, no se puede rellenar la vista
          // previa de una conversación cuyo último mensaje escribió el
          // interlocutor.
          && request.resource.data.lastMessage.senderId in resource.data.participantIds
          && request.resource.data.lastMessage.text is string
          && request.resource.data.lastMessage.text.size() > 0
          && request.resource.data.lastMessage.text.size() <= 2000
        ) || (
          isParticipant(resource.data.participantIds)
          && request.resource.data.participantIds is list
          && request.resource.data.participantIds.size() == 2
          && request.resource.data.participantIds.hasAny(['deleted-account'])
          && request.resource.data.participantIds.hasAny(resource.data.participantIds)
          && !request.resource.data.participantIds.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantIds', 'lastMessage'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
            || (
              resource.data.lastMessage.senderId == request.auth.uid
              && request.resource.data.lastMessage.senderId == 'deleted-account'
              && request.resource.data.lastMessage.senderName == 'Cuenta eliminada'
              && request.resource.data.lastMessage.text == resource.data.lastMessage.text
              && request.resource.data.lastMessage.diff(resource.data.lastMessage)
                .affectedKeys().hasOnly(['senderId', 'senderName'])
            )
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return signedIn() && chatId.split('__').hasAny([request.auth.uid]);
        }
        allow read: if isParticipant();
        allow create: if isParticipant()
        && isActiveUser()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
        allow update: if isParticipant()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['senderId', 'senderName'])
          && request.resource.data.senderId == 'deleted-account'
          && request.resource.data.senderName == 'Cuenta eliminada';
        allow delete: if false;
      }
    }

    /* ========================================================================
       COLABORACIÓN — Proyectos, miembros, invitaciones y actividad
       ======================================================================== */

    function isProjectMember(projectId, uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/projectMembers/$(projectId + '_' + uid));
    }

    function projectMemberData(projectId, uid) {
      return get(/databases/$(database)/documents/projectMembers/$(projectId + '_' + uid)).data;
    }

    function isProjectWriter(projectId) {
      return signedIn()
        && isProjectMember(projectId, request.auth.uid)
        && projectMemberData(projectId, request.auth.uid).role in ['owner', 'editor'];
    }

    function isProjectOwner(projectId) {
      return signedIn()
        && isProjectMember(projectId, request.auth.uid)
        && projectMemberData(projectId, request.auth.uid).role == 'owner';
    }

    match /projects/{projectId} {
      allow read: if signedIn()
        && (isAdmin()
          || resource.data.isPublic == true
          || isProjectMember(projectId, request.auth.uid)
          || resource.data.ownerId == request.auth.uid
          || pendingInvitationForRequester(projectId));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'ownerId', 'name', 'description', 'isPublic', 'createdAt', 'updatedAt',
          'thumbnailUrl', 'ownerName', 'sceneJson', 'ownerPhotoURL'
        ])
        && request.resource.data.id == projectId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.isPublic is bool
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;

      allow update: if signedIn()
        && (isAdmin() || isProjectOwner(projectId) || isProjectWriter(projectId))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'description', 'isPublic', 'updatedAt', 'thumbnailUrl', 'sceneJson'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPublic'])
          || isAdmin() || isProjectOwner(projectId)
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && (!('thumbnailUrl' in request.resource.data) || request.resource.data.thumbnailUrl == null || request.resource.data.thumbnailUrl is string)
        && (!('thumbnailUrl' in request.resource.data) || request.resource.data.thumbnailUrl == null || request.resource.data.thumbnailUrl.size() <= 100000);

      allow delete: if signedIn() && (isAdmin() || isProjectOwner(projectId));

      /* Bloqueos de objetos para edición colaborativa:
         el bloqueador (u owner) puede liberar; cualquier miembro de lectura
         puede ver quién bloquea cada objeto. */
      match /locks/{lockId} {
        allow read: if signedIn()
          && (isAdmin() || isProjectMember(projectId, request.auth.uid));

        allow create, update: if signedIn()
          && (isAdmin() || isProjectWriter(projectId))
          && request.resource.data.keys().hasOnly(['objectId', 'lockedBy', 'lockedAt'])
          && request.resource.data.objectId is string
          && request.resource.data.lockedBy == request.auth.uid
          && request.resource.data.lockedAt is number;

        allow delete: if signedIn()
          && (isAdmin() || isProjectWriter(projectId))
          && (resource.data.lockedBy == request.auth.uid || isProjectOwner(projectId));
      }
    }

    match /projectMembers/{memberId} {
      // La rama `resource.data.userId == request.auth.uid` permite demostrar la
      // regla para consultas `where('userId','==',uid)` (proyectos compartidos) y
      // deja leer la propia ficha de miembro. Sin ella, esas consultas se
      // rechazan con "Missing or insufficient permissions".
      allow read: if signedIn()
        && (isAdmin()
          || (resource.data.get('userId', '') == request.auth.uid)
          || (resource.data.projectId is string && isProjectMember(resource.data.projectId, request.auth.uid))
          || (resource.data.projectId is string
            && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid));

      allow create: if signedIn()
        && request.resource.data.projectId is string
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
        && request.resource.data.userId is string
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 120
        && request.resource.data.role in ['owner', 'editor', 'viewer']
        && request.resource.data.joinedAt is number
        && memberId == request.resource.data.projectId + '_' + request.resource.data.userId
        && request.resource.data.keys().hasOnly([
          'id', 'projectId', 'userId', 'userName', 'userPhotoURL', 'role', 'joinedAt', 'joinedViaShareLink'
        ])
        && request.resource.data.id == memberId
        && (request.resource.data.userPhotoURL == null || request.resource.data.userPhotoURL is string)
        && (!('joinedViaShareLink' in request.resource.data) || request.resource.data.joinedViaShareLink == null || request.resource.data.joinedViaShareLink is string)
        && (
          isAdmin()
          || (request.resource.data.userId == request.auth.uid
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid)
          || (request.resource.data.userId == request.auth.uid
            && request.resource.data.role in ['viewer', 'editor', 'owner']
            && request.auth.token.email is string
            && existsAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + tokenEmailLower()))
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + tokenEmailLower())).data.projectId == request.resource.data.projectId
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + tokenEmailLower())).data.invitedEmail == tokenEmailLower()
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + tokenEmailLower())).data.invitedUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + tokenEmailLower())).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + tokenEmailLower())).data.role == request.resource.data.role
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + tokenEmailLower())).data.respondedAt is number
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.projectId + '_' + tokenEmailLower())).data.expiresAt >= request.time.toMillis()
            && request.resource.data.joinedAt >= request.time.toMillis() - 300000
            && request.resource.data.joinedAt <= request.time.toMillis() + 300000)
          || (request.resource.data.userId == request.auth.uid
            && request.resource.data.role in ['viewer', 'editor']
            && request.resource.data.joinedViaShareLink is string
            && exists(/databases/$(database)/documents/projectShareLinks/$(request.resource.data.joinedViaShareLink))
            && get(/databases/$(database)/documents/projectShareLinks/$(request.resource.data.joinedViaShareLink)).data.projectId == request.resource.data.projectId
            && get(/databases/$(database)/documents/projectShareLinks/$(request.resource.data.joinedViaShareLink)).data.enabled == true
            && get(/databases/$(database)/documents/projectShareLinks/$(request.resource.data.joinedViaShareLink)).data.role == request.resource.data.role)
        );

      allow update: if signedIn()
        && memberId == resource.data.projectId + '_' + resource.data.userId
        && (
          (
            isAdmin() || isProjectOwner(resource.data.projectId)
          ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && (request.resource.data.role in ['editor', 'viewer']
          || (request.resource.data.role == 'owner' && (isAdmin() || isProjectOwner(request.resource.data.projectId))))
          || (
            request.auth.uid == resource.data.userId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['userName', 'userPhotoURL'])
            && request.resource.data.userName is string
            && request.resource.data.userName.size() > 0
            && request.resource.data.userName.size() <= 120
            && (request.resource.data.userPhotoURL == null || request.resource.data.userPhotoURL is string)
          )
          || (
            // Subida de rol al volver a unirte con un enlace de acceso.
            request.auth.uid == resource.data.userId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['role', 'joinedViaShareLink'])
            && request.resource.data.role in ['viewer', 'editor']
            && request.resource.data.joinedViaShareLink is string
            && exists(/databases/$(database)/documents/projectShareLinks/$(request.resource.data.joinedViaShareLink))
            && get(/databases/$(database)/documents/projectShareLinks/$(request.resource.data.joinedViaShareLink)).data.projectId == resource.data.projectId
            && get(/databases/$(database)/documents/projectShareLinks/$(request.resource.data.joinedViaShareLink)).data.enabled == true
            && get(/databases/$(database)/documents/projectShareLinks/$(request.resource.data.joinedViaShareLink)).data.role == request.resource.data.role
          )
        );

      allow delete: if signedIn()
        && (isAdmin() || isProjectOwner(resource.data.projectId) || request.auth.uid == resource.data.userId);
    }

    match /projectShareLinks/{linkId} {
      allow get: if signedIn();
      allow list: if signedIn()
        && (isAdmin()
          || (resource.data.projectId is string && (isProjectOwner(resource.data.projectId) || isProjectWriter(resource.data.projectId))));
      allow create: if signedIn()
        && request.resource.data.projectId is string
        && (isAdmin() || isProjectOwner(request.resource.data.projectId))
        && request.resource.data.id == linkId
        && request.resource.data.role in ['viewer', 'editor']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.enabled == true
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && request.resource.data.keys().hasOnly([
          'id', 'projectId', 'role', 'label', 'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'enabled'
        ])
        && (!('label' in request.resource.data) || request.resource.data.label is string);
      allow update: if signedIn()
        && resource.data.projectId is string
        && (isAdmin() || isProjectOwner(resource.data.projectId))
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'label', 'enabled', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || request.resource.data.role in ['viewer', 'editor'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['label']) || request.resource.data.label is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['enabled']) || request.resource.data.enabled is bool)
        && request.resource.data.updatedAt is number;
      allow delete: if signedIn()
        && resource.data.projectId is string
        && (isAdmin() || isProjectOwner(resource.data.projectId));
    }

    match /projectInvitations/{invitationId} {
      allow read: if signedIn()
        && (resource.data.invitedBy == request.auth.uid
          || (request.auth.token.email is string && resource.data.invitedEmail == tokenEmailLower())
          || (resource.data.invitedUid is string && resource.data.invitedUid == request.auth.uid)
          || isProjectWriter(resource.data.projectId));

      allow create: if signedIn()
        && (isAdmin() || isProjectWriter(request.resource.data.projectId))
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.invitedEmail is string
        && request.resource.data.invitedEmail.size() > 0
        && request.resource.data.invitedEmail.size() <= 120
        && request.resource.data.projectId is string
        && invitationId == request.resource.data.projectId + '_' + request.resource.data.invitedEmail
        && (request.resource.data.role in ['editor', 'viewer']
          || (request.resource.data.role == 'owner' && (isAdmin() || isProjectOwner(request.resource.data.projectId))))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.projectName is string
        && request.resource.data.keys().hasOnly([
          'id', 'projectId', 'projectName', 'invitedBy', 'invitedByName', 'invitedEmail',
          'invitedUid', 'role', 'status', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.id == invitationId
        && (request.resource.data.invitedUid == null || request.resource.data.invitedUid is string);

      allow update: if signedIn()
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.invitedEmail == resource.data.invitedEmail
        && (
          (
              // Reenvío/actualización de invitación pendiente por un miembro con permisos de escritura.
              (isAdmin() || isProjectWriter(resource.data.projectId))
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'projectName', 'invitedBy', 'invitedByName', 'role', 'status', 'createdAt', 'expiresAt', 'invitedUid'
            ])
            && request.resource.data.status == 'pending'
            && request.resource.data.expiresAt >= request.time.toMillis()
            && (request.resource.data.role in ['editor', 'viewer']
              || (request.resource.data.role == 'owner' && (isAdmin() || isProjectOwner(request.resource.data.projectId))))
            && request.resource.data.createdAt is number
            && request.resource.data.expiresAt is number
            && request.resource.data.invitedUid == null
            && request.resource.data.projectName is string
          ) || (
            // Aceptación/rechazo por la persona invitada, o por quien invitó.
            (resource.data.invitedBy == request.auth.uid
              || (request.auth.token.email is string && resource.data.invitedEmail == tokenEmailLower())
              || (resource.data.invitedUid is string && resource.data.invitedUid == request.auth.uid))
            && resource.data.expiresAt >= request.time.toMillis()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'respondedAt', 'invitedUid'])
            && request.resource.data.status in ['pending', 'accepted', 'rejected', 'revoked', 'expired']
            && (
              request.resource.data.status == resource.data.status
              || (
                resource.data.status == 'pending'
                && request.resource.data.respondedAt is number
                && (
                  (
                    (
                      (request.auth.token.email is string && resource.data.invitedEmail == tokenEmailLower())
                      || (resource.data.invitedUid is string && resource.data.invitedUid == request.auth.uid)
                    )
                    && request.resource.data.status in ['accepted', 'rejected']
                    && request.resource.data.invitedUid == request.auth.uid
                  ) || (
                    resource.data.invitedBy == request.auth.uid
                    && request.resource.data.status in ['revoked', 'expired', 'pending']
                  )
                )
              )
            )
          )
        );

      allow delete: if signedIn()
        && (resource.data.invitedBy == request.auth.uid || isProjectOwner(resource.data.projectId));
    }

    match /projectActivity/{activityId} {
      allow read: if signedIn()
        && (isAdmin() || isProjectMember(resource.data.projectId, request.auth.uid));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'projectId', 'actorId', 'actorName', 'action', 'objectId', 'objectType', 'snapshot', 'createdAt'
        ])
        && request.resource.data.id is string
        && request.resource.data.projectId is string
        && isProjectWriter(request.resource.data.projectId)
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 120
        && request.resource.data.action in [
          'object_created', 'object_updated', 'object_deleted',
          'material_changed', 'layer_changed'
        ]
        && request.resource.data.objectId is string
        && request.resource.data.objectId.size() <= 120
        && request.resource.data.objectType is string
        && request.resource.data.objectType.size() <= 60
        && (!('snapshot' in request.resource.data)
          || request.resource.data.snapshot == null
          || (request.resource.data.snapshot is string && request.resource.data.snapshot.size() <= 20000))
        && request.resource.data.createdAt is number;

      allow update: if false;
      allow delete: if false;
    }

    match /projectPresences/{presenceId} {
      allow read: if signedIn()
        && (isAdmin() || isProjectMember(resource.data.projectId, request.auth.uid));
      allow list: if signedIn()
        && (isAdmin()
          || (resource.data.projectId is string
            && isProjectMember(resource.data.projectId, request.auth.uid)));

      allow create: if signedIn()
        && isProjectMember(request.resource.data.projectId, request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.projectId is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.isOnline is bool
        && request.resource.data.lastSeen is number
        && request.resource.data.cursorX is number
        && request.resource.data.cursorY is number
        && (request.resource.data.currentObjectId == null
          || request.resource.data.currentObjectId is string)
        && (request.resource.data.photoURL == null
          || request.resource.data.photoURL is string)
        && (!('transform' in request.resource.data)
          || request.resource.data.transform == null
          || (request.resource.data.transform is map
            && request.resource.data.transform.objectId is string
            && request.resource.data.transform.updatedAt is number))
        && request.resource.data.keys().hasOnly([
          'uid', 'projectId', 'displayName', 'photoURL', 'isOnline',
          'currentObjectId', 'cursorX', 'cursorY', 'transform', 'lastSeen'
        ]);

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && isProjectMember(resource.data.projectId, request.auth.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isOnline', 'currentObjectId', 'cursorX', 'cursorY', 'transform', 'lastSeen', 'displayName', 'photoURL'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.lastSeen is number
        && (request.resource.data.photoURL == null
          || request.resource.data.photoURL is string)
        && (request.resource.data.currentObjectId == null
          || request.resource.data.currentObjectId is string);

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /helpArticles/{articleId} {
      // La pestaña de artículos de ayuda es solo de administradores
      // (`/admin`); los moderadores entran por `/moderation`, donde la pestaña
      // está deshabilitada. Se mantiene el mismo límite en las reglas.
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id', 'category', 'title', 'subtitle', 'icon', 'keywords',
          'body', 'steps', 'tip', 'order', 'isPublished', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.category in [
          'primeros-pasos', 'editor', 'publicacion', 'comunidad', 'colaboracion', 'cuenta'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.subtitle is string
        && request.resource.data.subtitle.size() > 0
        && request.resource.data.subtitle.size() <= 200
        && request.resource.data.icon is string
        && request.resource.data.keywords is string
        && request.resource.data.body is list
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['category', 'title', 'subtitle', 'icon', 'keywords', 'body', 'steps', 'tip', 'order', 'isPublished', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /userActivity/{uid} {
      // Esta colección NO guarda el correo: cada documento se puede leer
      // individualmente (`get`) desde cualquier usuario autenticado, porque el
      // chat muestra "visto hace" a los interlocutores. El panel de
      // administración obtiene el correo de `userPrivate`.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'lastSeenAt', 'lastSeenPath', 'updatedAt',
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.lastSeenPath is string
        && request.resource.data.lastSeenAt is number
        && request.resource.data.updatedAt is number;
      // 'email' se permite en `affectedKeys` solo para poder eliminar el campo
      // de los documentos antiguos; el documento nuevo no puede contenerlo.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'displayName', 'lastSeenAt', 'lastSeenPath', 'updatedAt'])
        && !('email' in request.resource.data)
        && request.resource.data.lastSeenAt is number
        && request.resource.data.updatedAt is number;
      allow get: if signedIn();
      // La lista completa de actividad es EXCLUSIVA de administradores (la usa
      // el panel de administración). El chat lee el documento de cada
      // interlocutor con `get`, que sí está permitido para cualquier usuario
      // autenticado. Así la lista global nunca se expone a usuarios ni
      // moderadores.
      allow list: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /accountDeletionAudit/{auditId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'uid', 'email', 'displayName', 'deletedAt', 'deletedBy', 'reason',
        ])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.deletedAt is number
        && (
          (
            request.resource.data.reason == 'self'
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.deletedBy == request.auth.uid
          ) || (
            request.resource.data.reason in ['inactivity', 'admin']
            && request.resource.data.deletedBy == request.auth.uid
            && canModerate()
          )
        );
      allow get, list: if canModerate();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
