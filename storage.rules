rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isModerator() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isBanned != true
        && userRole() in ['admin', 'moderator'];
    }

    function canReadPost(fileName, extensionPattern) {
      let postId = fileName.replace(extensionPattern, '');
      let postPath = /databases/(default)/documents/posts/$(postId);
      return firestore.exists(postPath)
        && (
          firestore.get(postPath).data.isPrivate != true
          || (signedIn() && firestore.get(postPath).data.author.uid == request.auth.uid)
          || isModerator()
        );
    }

    function isProjectMember(projectId) {
      return firestore.exists(/databases/(default)/documents/projectMembers/$(projectId + '_' + request.auth.uid));
    }

    function isProjectPublic(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data.isPublic == true;
    }

    match /models/{uid}/{fileName} {
      allow read: if (fileName.matches('^[A-Za-z0-9-]+\\.glb$')
        && ((signedIn() && request.auth.uid == uid)
          || isModerator()
          || canReadPost(fileName, '\\.glb$')));
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.size <= 100 * 1024 * 1024
        && (request.resource.contentType == 'model/gltf-binary'
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType.matches('model/gltf-binary;.*'));
      allow delete: if (signedIn() && request.auth.uid == uid) || isModerator();
    }

    match /thumbnails/{uid}/{fileName} {
      allow read: if (fileName.matches('^[A-Za-z0-9-]+\\.png$')
        && ((signedIn() && request.auth.uid == uid)
          || isModerator()
          || canReadPost(fileName, '\\.png$')));
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.size <= 8 * 1024 * 1024
        && (request.resource.contentType == 'image/png'
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType.matches('image/png;.*'));
      allow delete: if (signedIn() && request.auth.uid == uid) || isModerator();
    }

    match /projectThumbnails/{projectId}/{fileName} {
      allow read: if (firestore.exists(/databases/(default)/documents/projects/$(projectId))
        && (isProjectPublic(projectId)
          || (signedIn() && isProjectMember(projectId))
          || isModerator()));
      allow create, update: if signedIn()
        && isProjectMember(projectId)
        && request.resource.size <= 4 * 1024 * 1024
        && (request.resource.contentType == 'image/png'
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType.matches('image/png;.*'));
      allow delete: if signedIn() && (isProjectMember(projectId) || isModerator());
    }

    match /chatAudio/{conversationId}/{fileName} {
      // Solo los dos participantes del chat pueden leer/escribir el audio.
      // `conversationId` = `$(participantes ordenados)` (uidA__uidB).
      // Las notas de voz viajan CIFRADAS (E2E): los bytes subidos son opacos
      // (contentType `application/octet-stream`, extensión `.enc`); se
      // descifran en el dispositivo al reproducir. Los audios antiguos en
      // claro (`audio/*`) siguen aceptándose.
      function isConversationParticipant() {
        return signedIn()
          && conversationId.split('__').hasAny([request.auth.uid])
          && conversationId.size() <= 160;
      }
      allow read: if isConversationParticipant();
      allow create: if isConversationParticipant()
        && request.resource.size <= 5 * 1024 * 1024
        && (request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'application/octet-stream')
        && fileName.matches('^[A-Za-z0-9-]+\\.(webm|ogg|m4a|mp4|mp3|wav|enc)$');
      allow update, delete: if false;
    }

    match /chatImages/{conversationId}/{fileName} {
      // Igual que las notas de voz: las imágenes viajan CIFRADAS (E2E); los
      // bytes subidos son opacos (`application/octet-stream`, `.enc`). Se
      // descifran en el dispositivo al mostrarse. En claro siguen
      // permitiéndose previews antiguas (`image/*`).
      function isConversationParticipant() {
        return signedIn()
          && conversationId.split('__').hasAny([request.auth.uid])
          && conversationId.size() <= 160;
      }
      allow read: if isConversationParticipant();
      allow create: if isConversationParticipant()
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/octet-stream')
        && fileName.matches('^[A-Za-z0-9-]+\\.(png|jpe?g|webp|gif|avif|enc)$');
      allow update, delete: if false;
    }
  }
}
